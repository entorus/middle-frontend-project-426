# Copy to .env for Docker Compose. Never commit real credentials.
SENTRY_DSN=
POSTGRES_PORT=5432
APP_PORT=3000
# Required when running the API directly. Compose supplies its own PORT.
PORT=3000
SENTRY_ENVIRONMENT=development
VITE_SENTRY_DSN=
SENTRY_TEST_ENABLED=false
VITE_SENTRY_TEST_ENABLED=false

# Only used when running API directly on the host, not by Compose's app service.
DATABASE_URL=postgresql://psparts:local_password@localhost:5432/psparts
# Optional override: set true on HTTPS hosting, false only for local HTTP.
# Without an override, HTTPS / APP_ORIGIN / X-Forwarded-Proto enables Secure.
# COOKIE_SECURE=true
# Optional exact public origin when the reverse proxy changes the Host header.
# APP_ORIGIN=https://your-app.example.com
